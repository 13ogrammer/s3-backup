# Copy to .env (which is gitignored) and Expo will auto-load it on
# `npm start` / `npx expo start`. For EAS builds, set the same vars
# under the build profile's "Environment variables" section in the
# EAS dashboard so they're injected at build time.

# Public URL of the release manifest JSON, served from the public
# release bucket created by deploying the backend with
# CreateReleaseBucket=true. Leave unset (or empty) to disable the
# in-app update banner.
#
# Example:
# EXPO_PUBLIC_VERSION_MANIFEST_URL=https://s3-backup-releasebucket-XXXX.s3.<region>.amazonaws.com/manifest.json
EXPO_PUBLIC_VERSION_MANIFEST_URL=

# Sentry DSN for crash reporting. Leave unset (or empty) to disable Sentry
# entirely — all sentry.ts helpers become no-ops. Set in the EAS dashboard
# under the build profile's "Environment variables" for production builds.
#
# Example:
# EXPO_PUBLIC_SENTRY_DSN=https://abc123@o0.ingest.sentry.io/0
EXPO_PUBLIC_SENTRY_DSN=
