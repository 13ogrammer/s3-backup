# Copy to .env and source before running `npm run dev`.
# (We don't ship a dotenv loader — keep this simple by running:
#   set -a && source .env && set +a && npm run dev
# )

# Shared secret the app sends as `Authorization: Bearer ...`
BOOTSTRAP_TOKEN=devtoken

# Bucket name. For MinIO, any name works (create it once with `aws s3 mb`).
BUCKET_NAME=dev-bucket

# Set to your Mac's LAN IP so pre-signed URLs are reachable from your phone.
# Find it with: ipconfig getifaddr en0
# MinIO defaults to port 9000.
S3_ENDPOINT_URL=http://192.168.1.X:9000

# MinIO root credentials (must match docker-compose.yml; real AWS uses your CLI profile).
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
