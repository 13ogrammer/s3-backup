{
  "name": "s3-backup-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Serverless backend for the s3-backup app — mints pre-signed S3 URLs and lists bucket contents.",
  "main": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "sam build",
    "deploy": "sam deploy --guided",
    "local": "sam local start-api",
    "dev": "tsx watch src/dev-server.ts",
    "dev:localstack": "docker compose up -d",
    "dev:localstack:stop": "docker compose down",
    "backfill:thumbs": "tsx scripts/backfill-thumbnails.ts",
    "bootstrap:dist-bucket": "./scripts/bootstrap-dist-bucket.sh",
    "publish:template": "./scripts/publish-template.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^20.14.0",
    "esbuild": "^0.24.0",
    "sharp": "^0.34.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
