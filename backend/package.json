{
  "name": "s3-backup-backend",
  "version": "0.1.0",
  "author": "Prabhat Shrestha <13ogrammer@gmail.com>",
  "private": true,
  "description": "Serverless backend for the s3-backup app — mints pre-signed S3 URLs and lists bucket contents.",
  "main": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "sam build --build-in-source",
    "deploy": "sam deploy",
    "local": "sam local start-api",
    "dev": "tsx watch --env-file-if-exists=.env src/dev-server.ts",
    "dev:minio": "docker compose up -d",
    "dev:minio:stop": "docker compose down",
    "minio:ui": "open http://localhost:9001",
    "backfill:thumbs": "tsx --env-file-if-exists=.env scripts/backfill-thumbnails.ts",
    "backfill:video-thumbs": "tsx --env-file-if-exists=.env scripts/backfill-video-thumbs.ts",
    "check:bucket": "tsx scripts/check-bucket.ts",
    "qr": "tsx scripts/qr.ts",
    "bootstrap:dist-bucket": "./scripts/bootstrap-dist-bucket.sh",
    "publish:template": "./scripts/publish-template.sh",
    "ip": "ipconfig getifaddr en0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.700.0",
    "@aws-sdk/client-lambda": "^3.700.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^20.14.0",
    "@types/qrcode-terminal": "^0.12.2",
    "esbuild": "^0.28.0",
    "qrcode-terminal": "^0.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
